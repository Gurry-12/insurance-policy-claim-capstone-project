# Copy this file to `.env` (and to `.env.development` / `.env.production` as
# needed) locally. All of these files are gitignored so origins and keys never
# reach GitHub.

# Relative base URL: all API calls go through the same-origin Vite proxy
# (dev) or a host that serves /api (production). No backend origin needed here.
VITE_API_BASE_URL=/api

# Backend origin used by the Vite dev-server proxy (dev only). Required to run
# `npm run dev`; ignored by production builds.
VITE_API_PROXY_TARGET=http://localhost:8081

# --- Content-Security-Policy (VITE_CSP) --------------------------------------
# Development (copy to .env.development): empty so Vite HMR and the React
# refresh preamble work.
#   VITE_CSP=

# Production (copy to .env.production): served assets and API calls are
# same-origin, so connect-src 'self' is enough. If the backend is deployed on a
# separate host, add that origin to connect-src here.
#   VITE_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: res.cloudinary.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
