{
  "info": {
    "name": "Insurance End-to-End Scenario",
    "description": "Complete business flow from setup to claims",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Admin & Staff Setup",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"adminToken\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"cGFzc3dvcmQxMjM=\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Create Staff (Health)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Sarah Health\",\n  \"email\": \"sarah.health@insurance.com\",\n  \"password\": \"cGFzc3dvcmQxMjM=\",\n  \"mobileNumber\": \"+919876543201\",\n  \"productSpeciality\": \"HEALTH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/staff",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "staff"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Catalog",
      "item": [
        {
          "name": "Create Insurance Product (Health)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Comprehensive Health\",\n  \"productType\": \"HEALTH\",\n  \"description\": \"Full medical coverage including OPD and hospitalization.\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        },
        {
          "name": "Create Policy Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"planName\": \"Health Basic 5L\",\n  \"coverageAmount\": 500000,\n  \"premiumAmount\": 8000,\n  \"premiumType\": \"ANNUAL\",\n  \"duration\": 5,\n  \"termsAndConditions\": \"Room rent capped at 1% of sum insured.\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "plans"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer Onboarding",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"cGFzc3dvcmQxMjM=\",\n  \"mobileNumber\": \"+918000000001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"emailOtp\": \"123456\",\n  \"phoneOtp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-otp"
              ]
            }
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"customerToken\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"cGFzc3dvcmQxMjM=\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Create Customer Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateOfBirth\": \"1990-05-15\",\n  \"address\": \"123 Maple Street\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pinCode\": \"400001\",\n  \"nomineeName\": \"Mary Doe\",\n  \"nomineeRelation\": \"Spouse\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "profile"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Policy Operations",
      "item": [
        {
          "name": "Purchase Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": 1,\n  \"startDate\": \"2024-08-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/purchase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "purchase"
              ]
            }
          }
        },
        {
          "name": "Make Premium Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": 1,\n  \"amount\": 8000,\n  \"paymentMode\": \"UPI\",\n  \"paymentStatus\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. The Claims Workflow",
      "item": [
        {
          "name": "Customer Raises Claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "claim",
                  "value": "{\n  \"policyId\": 1,\n  \"claimAmount\": 45000,\n  \"claimReason\": \"Hospitalization due to Dengue fever\",\n  \"incidentDate\": \"2024-08-10\"\n}",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/raise",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "raise"
              ]
            }
          }
        },
        {
          "name": "Staff Log In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"staffToken\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah.health@insurance.com\",\n  \"password\": \"cGFzc3dvcmQxMjM=\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Staff Assigns Claim",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "1",
                "assign"
              ]
            }
          }
        },
        {
          "name": "Staff Moves to Under Review",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/under-review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "1",
                "under-review"
              ]
            }
          }
        },
        {
          "name": "Staff Recommends Approval",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recommendedStatus\": \"RECOMMENDED_FOR_APPROVAL\",\n  \"remarks\": \"Documents verified. Hospitalization bills are genuine.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "1",
                "review"
              ]
            }
          }
        },
        {
          "name": "Admin Final Decision (Approval)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recommendedStatus\": \"APPROVED\",\n  \"remarks\": \"Final approval granted based on staff verification.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/final-decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "1",
                "final-decision"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Maintenance & Read Operations",
      "item": [
        {
          "name": "View Claim History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "1",
                "history"
              ]
            }
          }
        },
        {
          "name": "Paginated Customers Search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers?pageNumber=0&pageSize=10&sortBy=fullName&sortDirection=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "0"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "fullName"
                },
                {
                  "key": "sortDirection",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel Policy",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/1/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "1",
                "cancel"
              ]
            }
          }
        }
      ]
    }
  ]
}
